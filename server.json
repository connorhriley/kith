{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.connorhriley/kith",
  "title": "Kith",
  "description": "Coordinate coding agents with work claims, Git worktrees, shared resources and verified integration.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/connorhriley/kith",
    "source": "github"
  },
  "websiteUrl": "https://github.com/connorhriley/kith#quick-start",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/connorhriley/kith/main/assets/brand/avatar.png",
      "mimeType": "image/png",
      "sizes": [
        "256x256"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "kith-coord",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--yes"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--repo",
          "description": "Absolute path to the Git checkout to coordinate. Git 2.38+ and Node 22.13+ (22.x) or 24+ required.",
          "format": "filepath",
          "isRequired": true
        }
      ]
    }
  ]
}
