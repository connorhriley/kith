{
  "name": "kith-coord",
  "version": "0.1.7",
  "description": "Local coordination for cooperating coding agents: work claims, isolated worktrees, shared resources, and verified integration without a hosted service.",
  "type": "module",
  "bin": {
    "kith": "./dist/cli/index.js",
    "coord": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE",
    "docs",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "assets/brand",
    "bin/kith-menubar"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsup && vitest run",
    "test:watch": "tsup && vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "tsup && node scripts/build-menubar.mjs --if-supported",
    "test:package": "pnpm build && node scripts/smoke-package.mjs",
    "demo": "pnpm build && node examples/two-agents.mjs",
    "test:clients": "pnpm build && node scripts/validate-native-clients.mjs",
    "protocol:export": "pnpm build && node scripts/export-protocol.mjs",
    "protocol:check": "node scripts/export-protocol.mjs --check",
    "build:menubar": "node scripts/build-menubar.mjs",
    "test:menubar": "node scripts/test-menubar.mjs"
  },
  "keywords": [
    "ai-agents",
    "parallel-agents",
    "mcp",
    "claude-code",
    "codex",
    "antigravity",
    "cursor",
    "git-worktree",
    "coordination",
    "multi-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "picomatch": "^4.0.2",
    "smol-toml": "^1.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/picomatch": "^4.0.0",
    "tsup": "^8.4.0",
    "vitest": "^3.0.7",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/connorhriley/kith.git"
  },
  "homepage": "https://github.com/connorhriley/kith#readme",
  "bugs": {
    "url": "https://github.com/connorhriley/kith/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "mcpName": "io.github.connorhriley/kith"
}
